# Render Worker - Remotion + HyperFrames + FFmpeg
FROM node:22-alpine

# Install system dependencies
RUN apk add --no-cache \
    ffmpeg \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    python3 \
    make \
    g++

# Set up Chrome for headless
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY remotion-composer/package*.json ./remotion-composer/

# Install dependencies
RUN npm ci --workspaces --include-workspace-root

# Copy source
COPY . .

# Build Remotion
WORKDIR /app/remotion-composer
RUN npm run build

# Build worker entrypoint
WORKDIR /app
RUN npx tsc mvp/apps/render-worker/index.ts --outDir dist --esModuleInterop --resolveJsonModule --module commonjs --target ES2020 --moduleResolution node 2>/dev/null || true

# Default command
CMD ["node", "dist/mvp/apps/render-worker/index.js"]