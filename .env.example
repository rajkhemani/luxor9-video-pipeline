# ─── Core (Generate with: openssl rand -base64 32) ────────────────
PB_ENCRYPTION_KEY=
PB_ADMIN_EMAIL=admin@yourdomain.com
PB_ADMIN_PASSWORD=

# ─── Higgsfield Cloud (Get from https://cloud.higgsfield.ai/api-keys) ─
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ─── Cloudflare R2 (Create bucket at https://dash.cloudflare.com → R2) ─
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=openmontage-assets

# ─── Clerk Auth (Create app at https://clerk.com) ───────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# ─── Site URL ───────────────────────────────────────────────────────
SITE_URL=https://yourdomain.com

# ─── Upstash Redis (Create at https://console.upstash.com) ──────────
UPSTASH_REDIS_URL=rediss://default:xxx@us1-precise-xxx.upstash.io:6379

# ─── Optional Provider Keys (User BYOK in UI, these are fallbacks) ──
FAL_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=
OPENAI_API_KEY=