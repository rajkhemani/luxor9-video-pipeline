{
  "mcpServers": {
    "minimax": {
      "command": "uvx",
      "args": ["minimax-mcp"],
      "env": {
        "MINIMAX_API_KEY": "${MINIMAX_API_KEY}",
        "MINIMAX_API_HOST": "${MINIMAX_API_HOST}",
        "MINIMAX_MCP_BASE_PATH": "${CLAUDE_PLUGIN_DATA}",
        "MINIMAX_API_RESOURCE_MODE": "url"
      }
    }
  }
}
